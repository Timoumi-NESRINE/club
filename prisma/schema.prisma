// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String?
  lastName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Activity tracking for automatic deactivation
  lastActiveAt      DateTime? // Last user activity timestamp
  deactivatedAt     DateTime? // When account was deactivated
  deactivationReason String?  // Reason for deactivation (e.g., "INACTIVITY_3_MONTHS")

  // Password policy fields
  passwordExpiresAt DateTime? // Password expiration date (3 months from creation/update)
  previousPasswords String[]  // Array of hashed previous passwords (last 5)

  // Relationships
  userRoles UserRole[]
  clientsCreated Client[]
  loginLogs UserLoginLog[]
  passwordHistory PasswordHistory[]
  leadsAssigned Lead[] @relation("LeadAssignee")
  dealsCreated Deal[] @relation("DealCreator")
  followUpsCreated FollowUp[] @relation("FollowUpCreator")
  nurturingCreated NurturingSequence[] @relation("NurturingCreator")
  alertsResolved SystemAlert[] @relation("AlertResolver")
  campaignsCreated MarketingCampaign[] @relation("CampaignCreator")

  @@map("users")
}

// Role model
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// Permission model
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  resource    String? // e.g., "users", "posts", "settings"
  action      String? // e.g., "create", "read", "update", "delete"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  rolePermissions RolePermission[]

  @@map("permissions")
}

// Many-to-many relationship between User and Role
model UserRole {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  assignedAt DateTime @default(now())
  assignedBy String? // ID of the user who assigned this role

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Many-to-many relationship between Role and Permission
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())
  grantedBy    String? // ID of the user who granted this permission

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Client {
  id             String   @id @default(cuid())
  nom            String
  prenom         String
  mail           String
  phone          String?
  adresse        String?
  codePostal     String?
  region         String?
  pays           String?
  dateAdhesion   DateTime
  codeAgence     String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("clients")
}

// User login/logout logs
model UserLoginLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // "LOGIN" or "LOGOUT"
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("user_login_logs")
}

// Password history for preventing reuse
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  password  String   // Hashed password
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

// Fiche Joueur (Player Registration)
model Player {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String   @unique
  birthDate         DateTime
  licenseNumber     String   @unique
  category          String     // "U14", "Senior", etc.
  bloodGroup        String     // "A+", "O-", etc.
  height            Float?     // cm
  weight            Float?     // kg
  medicalCertUrl    String?    // Scan du certificat médical
  idScanUrl         String?    // Scan CIN/Passeport
  status            String   @default("PENDING") // PENDING, VALIDATED, REJECTED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("players")
}

// Lead Management
model Lead {
  id                String   @id @default(cuid())
  name              String
  email             String
  company           String?
  phone             String?
  address           String?
  website           String?
  linkedinUrl       String?
  source            String   // "email_inbound", "google_maps", "hubspot_form", "linkedin", "manual"
  status            String   @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, WON, LOST, NURTURING
  icpScore          Int?     // ICP Score 1-10
  companyTarget     String?  // Detected company target
  serviceLine       String?  // Detected service line
  message           String?  @db.Text
  notes             String?  @db.Text
  assignedTo        String?  // User ID
  lastContactDate   DateTime?
  nextFollowUpDate  DateTime?
  metadata          Json?    // Additional data
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedToUser    User?    @relation("LeadAssignee", fields: [assignedTo], references: [id])
  deals             Deal[]
  followUps         FollowUp[]
  nurturingSequence NurturingSequence[]

  @@map("leads")
}

// Sales Pipeline / Deals
model Deal {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title             String
  value             Float?
  stage             String   @default("PROSPECT") // PROSPECT, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  probability       Int?     // 0-100
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  proposalContent   String?  @db.Text
  proposalSentAt    DateTime?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator           User     @relation("DealCreator", fields: [createdBy], references: [id])

  @@map("deals")
}

// Marketing Campaigns
model MarketingCampaign {
  id                String   @id @default(cuid())
  name              String
  type              String   // "social_media", "email", "blog", "linkedin"
  platform          String?  // "facebook", "instagram", "linkedin", "email"
  status            String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
  content           String   @db.Text
  imageUrl          String?
  scheduledFor      DateTime?
  publishedAt       DateTime?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator           User     @relation("CampaignCreator", fields: [createdBy], references: [id])

  @@map("marketing_campaigns")
}

// Follow-ups / Relances
model FollowUp {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type              String   // "J+1", "J+3", "J+7", "MANUAL"
  status            String   @default("PENDING") // PENDING, SENT, COMPLETED, SKIPPED
  scheduledFor      DateTime
  sentAt            DateTime?
  content           String   @db.Text
  channel           String   // "email", "whatsapp", "linkedin"
  notes             String?  @db.Text
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator           User     @relation("FollowUpCreator", fields: [createdBy], references: [id])

  @@map("follow_ups")
}

// Nurturing Sequences
model NurturingSequence {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceType      String   // "J+30", "J+60", "J+90", "J+120"
  status            String   @default("PENDING") // PENDING, ACTIVE, COMPLETED, PAUSED
  scheduledFor      DateTime
  sentAt            DateTime?
  content           String   @db.Text
  serviceLine       String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator           User     @relation("NurturingCreator", fields: [createdBy], references: [id])

  @@map("nurturing_sequences")
}

// System Monitoring / Alerts
model SystemAlert {
  id                String   @id @default(cuid())
  type              String   // "ERROR", "WARNING", "INFO"
  source            String   // "email_agent", "lead_generation", "marketing", "sales", "system"
  message           String   @db.Text
  severity          String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status            String   @default("OPEN") // OPEN, RESOLVED, IGNORED
  metadata          Json?
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resolver          User?    @relation("AlertResolver", fields: [resolvedBy], references: [id])

  @@map("system_alerts")
}

// KPIs / Metrics
model KpiMetric {
  id                String   @id @default(cuid())
  metricName        String   // "total_leads", "qualified_leads", "conversion_rate", "roi"
  metricValue       Float
  metricDate        DateTime
  period            String   // "daily", "weekly", "monthly"
  metadata          Json?
  createdAt         DateTime @default(now())

  @@unique([metricName, metricDate, period])
  @@map("kpi_metrics")
}
